local function pressBtn(btn, sig)
	if getconnections then
		local ok, n = pcall(function()
			local list = getconnections(btn[sig])
			for _, c in ipairs(list) do c:Fire() end
			return #list
		end)
		if ok and n > 0 then return true end
	end
	if firesignal and pcall(firesignal, btn[sig]) then return true end
	return false
end

