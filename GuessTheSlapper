-- footer sidebar: ping + fps live
do
	local frames, acc, fps = 0, 0, 60
	keep(RunService.RenderStepped:Connect(function(dt)
		frames, acc = frames + 1, acc + dt
		if acc >= 0.5 then
			fps, frames, acc = math.floor(frames / acc + 0.5), 0, 0
		end
	end))
	task.spawn(function()
		while alive do
			local p = getPing()
			sideStat.Text = ("%dms  %dfps"):format(p, fps)
			sideStat.TextColor3 = p < 120 and T.good or (p < 220 and T.warn or T.bad)
			task.wait(0.5)
		end
	end)
end

local function Unload()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	clearMarks()
	pcall(function() gui:Destroy() end)
	env.__SlapAssistant = nil
end
env.__SlapAssistant = {Unload = Unload}
btnClose.Activated:Connect(Unload)

