local function Toggle(parent, title, desc, default, cb)
	local row = mk("TextButton", {Size = UDim2.new(1, 0, 0, desc and 46 or 36), BackgroundColor3 = T.panel2, AutoButtonColor = false, Text = ""}, parent)
	corner(row, 8)
	local t = label(row, title, 13, T.text, FB)
	t.Position, t.Size = UDim2.fromOffset(12, desc and 7 or 0), UDim2.new(1, -70, 0, desc and 16 or 36)
	if desc then
		local d = label(row, desc, 11, T.sub)
		d.Position, d.Size = UDim2.fromOffset(12, 24), UDim2.new(1, -70, 0, 14)
	end
	local sw = mk("Frame", {Size = UDim2.fromOffset(38, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = T.off}, row)
	corner(sw, 10)
	local knob = mk("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = WHITE}, sw)
	corner(knob, 7)
	local obj = {Value = default and true or false}
	local function paint(animate)
		local col = obj.Value and T.accent or T.off
		local pos = obj.Value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
		if animate then
			tween(sw, 0.15, {BackgroundColor3 = col})
			tween(knob, 0.15, {Position = pos})
		else
			sw.BackgroundColor3, knob.Position = col, pos
		end
	end
	function obj.Set(v, silent)
		obj.Value = v and true or false
		paint(true)
		if not silent and cb then cb(obj.Value) end
	end
	row.Activated:Connect(function() obj.Set(not obj.Value) end)
	onAccent(function() paint(false) end)
	return obj
end
local bound = {}
local function BoundToggle(parent, key, title, desc, after)
	local obj = Toggle(parent, title, desc, S[key], function(v)
		S[key] = v
		for _, o in ipairs(bound[key]) do
			if o.Value ~= v then o.Set(v, true) end
		end
		if after then after(v) end
	end)
	bound[key] = bound[key] or {}
	table.insert(bound[key], obj)
	return obj
end
local function Slider(parent, title, min, max, default, fmt, cb)
	fmt = fmt or tostring
	local box = mk("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = T.panel2}, parent)
	corner(box, 8)
	local t = label(box, title, 12, T.sub)
	t.Position, t.Size = UDim2.fromOffset(12, 7), UDim2.new(0.65, -12, 0, 16)
	local v = label(box, "", 12, T.text, FB, Enum.TextXAlignment.Right)
	v.Position, v.Size = UDim2.new(0.65, 0, 0, 7), UDim2.new(0.35, -12, 0, 16)
	local track = mk("Frame", {Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 34), BackgroundColor3 = T.off}, box)
	corner(track, 3)
	local fill = mk("Frame", {Size = UDim2.fromScale(0, 1)}, track)
	corner(fill, 3)
	local knob = mk("Frame", {Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = WHITE, ZIndex = 2}, track)
	corner(knob, 8)
	local hit = mk("TextButton", {Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 20), BackgroundTransparency = 1, Text = ""}, box)
	local obj = {Value = default}
	onAccent(function() fill.BackgroundColor3 = T.accent end)
	local function render()
		local a = (obj.Value - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		v.Text = fmt(obj.Value)
	end
	function obj.Set(x, silent)
		x = math.floor(math.clamp(x, min, max) + 0.5)
		local old = obj.Value
		obj.Value = x
		render()
		if not silent and cb and x ~= old then cb(x) end
	end
	local dragging, dragInput = false, nil
	local function fromInput(i)
		local a = math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		obj.Set(min + a * (max - min))
	end
	local function lockScroll(lock)
		local sf = box:FindFirstAncestorOfClass("ScrollingFrame")
		if sf then sf.ScrollingEnabled = not lock end
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragInput = true, i
			lockScroll(true)
			fromInput(i)
		end
	end)
	keep(UIS.InputChanged:Connect(function(i)
		if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseMovement) then fromInput(i) end
	end))
	keep(UIS.InputEnded:Connect(function(i)
		if dragging and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
			dragging = false
			lockScroll(false)
		end
	end))
	obj.Set(default, true)
	return obj
end
local function Segmented(parent, options, default, cb)
	local box = mk("Frame", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.panel2}, parent)
	corner(box, 8)
	pad(box, 3, 3)
	hlist(box, 4)
	local obj, btns, n = {Value = default}, {}, #options
	local function paint()
		for name, b in pairs(btns) do
			local on = name == obj.Value
			b.BackgroundTransparency = on and 0 or 1
			b.BackgroundColor3 = T.accent
			b.TextColor3 = on and WHITE or T.sub
		end
	end
	for i, name in ipairs(options) do
		local b = mk("TextButton", {Size = UDim2.new(1 / n, -4 * (n - 1) / n, 1, 0), Text = name, Font = FB, TextSize = 12, AutoButtonColor = false, LayoutOrder = i}, box)
		corner(b, 6)
		btns[name] = b
		b.Activated:Connect(function()
			obj.Value = name
			paint()
			cb(name)
		end)
	end
	onAccent(paint)
	return obj
end
local function Chips(parent, values, onPick)
	local row = mk("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1}, parent)
	hlist(row, 6)
	local btns, cur, n = {}, nil, #values
	local function refresh(c)
		cur = c
		for v, b in pairs(btns) do
			local on = v == cur
			b.BackgroundColor3 = on and T.accent or T.panel2
			b.TextColor3 = on and WHITE or T.text
		end
	end
	for i, v in ipairs(values) do
		local b = mk("TextButton", {Size = UDim2.new(1 / n, -6 * (n - 1) / n, 1, 0), BackgroundColor3 = T.panel2, Text = v .. "%", TextColor3 = T.text, Font = FB, TextSize = 12, AutoButtonColor = false, LayoutOrder = i}, row)
		corner(b, 7)
		b.Activated:Connect(function() onPick(v) end)
		btns[v] = b
	end
	onAccent(function() refresh(cur) end)
	return {Refresh = refresh}
end
