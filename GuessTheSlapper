---------------------------------------------------------------- STATE
local S
do
	local raw = {
		autoSlap = true, autoDodge = true, autoGuess = false,
		worldHL = true, notify = true,
		mode = "Fixed", power = 100, rmin = 85, rmax = 100, trigger = 90,
		dodgeMode = "Reflex", dMin = 40, dMax = 90, dChance = 100,
		accent = "Indigo",
	}
	local FILE, queued = "SlapAssistant_v3.json", false
	local function save()
		if not writefile or queued then return end
		queued = true
		task.delay(0.8, function()
			queued = false
			pcall(function() writefile(FILE, game:GetService("HttpService"):JSONEncode(raw)) end)
		end)
	end
	if isfile and readfile then
		pcall(function()
			if not isfile(FILE) then return end
			local data = game:GetService("HttpService"):JSONDecode(readfile(FILE))
			for k, v in pairs(raw) do
				if type(data[k]) == type(v) then raw[k] = data[k] end
			end
		end)
	end
	if raw.mode ~= "Fixed" and raw.mode ~= "Random" and raw.mode ~= "Perfect" then raw.mode = "Fixed" end
	if raw.dodgeMode ~= "Reflex" and raw.dodgeMode ~= "Human" then raw.dodgeMode = "Reflex" end
	-- setiap S.x = v otomatis tersimpan
	S = setmetatable({}, {
		__index = raw,
		__newindex = function(_, k, v)
			raw[k] = v
			save()
		end,
	})
end
