-- jadi dihitung "baru" lagi kalau sempat berhenti.
do
	local active = setmetatable({}, {__mode = "k"})
	local hooked = setmetatable({}, {__mode = "k"})
	local stamp = 0
	local function handleTrack(p, tr)
		local kind, name = classify(tr)
		if kind == "slap" then onSlap(p, name) end
	end
	local function scan()
		stamp = stamp + 1
		for _, p in ipairs(Players:GetPlayers()) do
			local ch = p ~= LP and p.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local an = hum and hum:FindFirstChildOfClass("Animator")
			if an then
				if not hooked[an] then
					hooked[an] = true
					keep(an.AnimationPlayed:Connect(function(tr) pcall(handleTrack, p, tr) end))
				end
				for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
					local last = active[tr]
					active[tr] = stamp
					if not last or last < stamp - 1 then handleTrack(p, tr) end
				end
			end
		end
	end
	task.spawn(function()
		while alive do
			task.wait(0.05)
			pcall(scan)
		end
	end)
end

local function clearMarks()
	if worldHL then
		pcall(function() worldHL:Destroy() end)
		worldHL = nil
	end
	local g = gameGui()
	local sf = g and g:FindFirstChild("suspects")
	if sf then
		for _, b in ipairs(sf:GetChildren()) do
			local m = b:FindFirstChild("SA_Mark")
			if m then m:Destroy() end
		end
	end
end
local function findSuspectBtn(name)
	local g = gameGui()
	local sf = g and g:FindFirstChild("suspects")
	if not sf then return nil end
	for _, b in ipairs(sf:GetChildren()) do
		if b:IsA("ImageButton") then
			local n = b:FindFirstChild("name")
			local ok, txt = pcall(function() return n.Text end)
			if ok and txt == name then return b end
		end
	end
end
local function markCulprit(plr)
	clearMarks()
	local b = findSuspectBtn(plr.Name)
	if b then mk("UIStroke", {Name = "SA_Mark", Color = T.good, Thickness = 4}, b) end
	if S.worldHL and plr.Character and holder then
		worldHL = mk("Highlight", {Adornee = plr.Character, FillColor = T.bad, OutlineColor = WHITE, FillTransparency = 0.6, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop})
		pcall(function() worldHL.Parent = holder end)
	end
end

doGuess = function(manual)
	local e = culprit
	if not e then
		if manual then toast("Pelaku belum terdeteksi", T.bad) end
		return
	end
	local b = findSuspectBtn(e.plr.Name)
	if b and pressBtn(b, "MouseButton1Click") then
		addLog("menebak " .. e.plr.Name .. " (klik tombol suspects)", T.good)
	else
		R.Guess:FireServer(e.plr.Name)
		addLog("menebak " .. e.plr.Name .. " (remote)", T.good)
	end
end

keep(R.Guess.OnClientEvent:Connect(function(list)
	if type(list) ~= "table" then
		promptActive, culprit = false, nil
		clearMarks()
		refreshCulprit()
		return
	end
	promptActive = true
	culprit = nil
	for i = #slapEvents, 1, -1 do
		local e = slapEvents[i]
		if os.clock() - e.t > 20 then break end
		for _, p in pairs(list) do
			if p == e.plr then culprit = e break end
		end
		if culprit then break end
	end
	refreshCulprit()
	if culprit then
		toast("PELAKU: " .. culprit.plr.Name, T.good)
		addLog(("pelaku: %s (%s)"):format(culprit.plr.Name, culprit.move), T.good)
		later(0.25, function() if promptActive and culprit then markCulprit(culprit.plr) end end)
		if S.autoGuess then
			later(0.8 + math.random() * 0.9, function() if promptActive then doGuess(false) end end)
		end
	else
		toast("Pelaku tidak terdeteksi", T.bad)
		addLog("pelaku tidak terdeteksi (animasi slap tidak terlihat)", T.bad)
	end
end))

keep(R.Resety.OnClientEvent:Connect(function()
	promptActive, culprit = false, nil
	clearMarks()
	refreshCulprit()
end))

task.spawn(function()
	while alive do
		task.wait(1)
		pcall(refreshCulprit)
	end
end)

---------------------------------------------------------------- WINDOW CONTROLS
local winScale = win:FindFirstChildOfClass("UIScale")
local openTok = 0
local function setOpen(on)
	openTok = openTok + 1
	local mine = openTok
	if on then
		win.Visible = true
		winScale.Scale = 0.92
		tween(winScale, 0.18, {Scale = 1})
	else
		tween(winScale, 0.12, {Scale = 0.92})
		later(0.13, function() if mine == openTok then win.Visible = false end end)
	end
end
local function toggleWin() setOpen(not win.Visible) end

local fab = mk("TextButton", {Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 14, 0.5, -60), Text = "S", TextColor3 = WHITE, Font = FB, TextSize = 18, AutoButtonColor = false}, gui)
