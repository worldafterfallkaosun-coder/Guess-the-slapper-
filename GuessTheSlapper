local pages, tabBtns = {}, {}
local function newPage(name)
	local p = mk("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.off, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
	}, content)
	pad(p, 10, 10, 12, 10)
	vlist(p, 8)
	pages[name] = p
	return p
end
local function showTab(name)
	for n, p in pairs(pages) do
		if n == name then
			if not p.Visible then
				p.Position = UDim2.fromOffset(0, 10)
				p.Visible = true
				tween(p, 0.18, {Position = UDim2.fromOffset(0, 0)})
			end
		else
			p.Visible = false
		end
	end
	for n, t in pairs(tabBtns) do t.paint(n == name) end
end
for i, name in ipairs({"Dashboard", "Slap", "Dodge", "Tracker", "Log", "Setelan"}) do
	local b = mk("TextButton", {Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.panel2, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i}, tabHolder)
	corner(b, 8)
	local bar = mk("Frame", {Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 0, 0.5, -8), Visible = false}, b)
	corner(bar, 2)
	local l = label(b, name, 13, T.sub, FB)
	l.Position, l.Size = UDim2.fromOffset(14, 0), UDim2.new(1, -14, 1, 0)
	local active = false
	tabBtns[name] = {paint = function(on)
		active = on
		b.BackgroundTransparency = on and 0 or 1
		l.TextColor3 = on and T.text or T.sub
		bar.Visible = on
		bar.BackgroundColor3 = T.accent
	end}
	onAccent(function() tabBtns[name].paint(active) end)
	b.Activated:Connect(function() showTab(name) end)
end

