local PRETTY = {
	hardslapper = "Slap Default", spike = "Spike", bikeslapper = "Bicycle Kick", backhandslapper = "Backhand",
	backflipslapper = "Backflip", backkick = "Backkick", uppercut = "Uppercut", barrage = "Barrage",
	airstrike = "Airstrike", dropkick = "Drop Kick", tableflip = "Table Flip", rko = "RKO",
	dempseyroll = "Dempsey Roll", katana = "Katana", reversalred = "Reversal Red", delete = "Delete",
}
local SLAP_WORDS = {"slapper", "uppercut", "barrage", "airstrike", "spike", "backkick", "dropkick", "tableflip", "rko", "dempsey", "katana", "reversal", "delete"}
local animMap, nSlap, nDodge = {}, 0, 0
local function idOf(s) return tonumber(tostring(s):match("%d+")) end
local function indexFolder(folder, kind)
	if not folder then return end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("Animation") then
			local id = idOf(d.AnimationId)
			if id then animMap[id] = {name = d.Name, kind = kind} end
		end
	end
end
indexFolder(RS:FindFirstChild("dodges"), "dodge")
indexFolder(RS:FindFirstChild("anims"), "slap")
for _, v in pairs(animMap) do
	if v.name == "sit" or v.name == "default" then v.kind = "other" end
	if v.kind == "slap" then nSlap = nSlap + 1 elseif v.kind == "dodge" then nDodge = nDodge + 1 end
end
local function classify(track)
	local anim = track.Animation
	local id = anim and idOf(anim.AnimationId)
	local info = id and animMap[id]
	if info then return info.kind, info.name end
	local n = string.lower(track.Name or "")
	for _, k in ipairs(SLAP_WORDS) do
		if string.find(n, k, 1, true) then return "slap", track.Name end
	end
	return nil
end

