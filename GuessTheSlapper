local function onSlap(plr, rawName)
	local now = os.clock()
	if lastSlap and lastSlap.plr == plr and now - lastSlap.t < 0.5 then return end
	local move = PRETTY[rawName] or rawName
	lastSlap = {plr = plr, move = move, t = now, src = "animasi"}
	slapEvents[#slapEvents + 1] = lastSlap
	if #slapEvents > 40 then table.remove(slapEvents, 1) end
	addHistory(plr, move)
	addLog(("slap terdeteksi: %s (%s)"):format(plr.Name, move), T.warn)
	toast(("Slap oleh %s (%s)"):format(plr.Name, move), T.warn)
	refreshCulprit()
end

