local cache = {}
local function gameGui()
	local g = cache.gui
	if g and g.Parent then return g end
	local pg = LP:FindFirstChild("PlayerGui")
	g = pg and pg:FindFirstChild("ScreenGui")
	cache.gui, cache.meter, cache.bar, cache.btn = g, nil, nil, nil
