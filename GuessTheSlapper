---------------------------------------------------------------- LOGIC: AUTO SLAP
local function choosePower()
	if S.mode == "Perfect" then return math.random(98, 100) / 100 end
	if S.mode == "Random" then
		local lo, hi = math.min(S.rmin, S.rmax), math.max(S.rmin, S.rmax)
		return math.random(lo, hi) / 100
	end
	return S.power / 100
end

local meterActive, fired, sweepTarget, lastY = false, false, nil, 0
local function newSweep()
	fired = false
	sweepTarget = choosePower()
	for _, w in ipairs(meters) do
		w.Target(sweepTarget)
		w.Status(("AKTIF | target %d%%"):format(pct(sweepTarget)), T.good)
	end
end

keep(RunService.Heartbeat:Connect(function()
	if not alive then return end
	local meter, bar = gameMeter()
	local vis = meter and bar and meter.Visible
	if not vis then
		if meterActive then
			meterActive = false
			for _, w in ipairs(meters) do
				w.Status("IDLE", T.sub)
				w.Bar(0)
			end
			refreshMarkers()
			pillMeter("Meter: idle", T.sub)
		end
		return
	end
	local y = bar.Position.Y.Scale
	if not meterActive then
		meterActive, lastY = true, y
		newSweep()
		pillMeter("Meter: AKTIF", T.good)
		addLog("meter mulai", T.sub)
	elseif y < lastY - 0.3 then
		newSweep()
	end
	lastY = y
	for _, w in ipairs(meters) do w.Bar(y) end
	if S.autoSlap and not fired and sweepTarget then
		local trig = math.min(sweepTarget, S.trigger / 100)
		if y >= trig then
			fired = true
			local v = math.clamp(sweepTarget, 0.01, 0.999)
			pcall(function() R.SendSlap:FireServer(v) end)
			stats.slaps = stats.slaps + 1
			stats.lastPower = v
			refreshStats()
			addLog(("slap dikirim %d%% (bar %.2f)"):format(pct(v), y), T.good)
		end
	end
end))

keep(R.SlapPercent.OnClientEvent:Connect(function(plr, p, big)
	p = tonumber(p) or 0
	stats.lastServer = p
	refreshStats()
	addLog(("SlapPercent: %s %d%% big=%s"):format(tostring(plr), pct(p), tostring(big)), T.sub)
end))

---------------------------------------------------------------- LOGIC: AUTO DODGE
do
	local promptT, token = 0, 0

	-- tekan tombol dodge lewat handler game (kalau sudah tampil); kalau tombol belum muncul
	-- dalam 2 frame atau window hampir habis -> kirim remote langsung.
	local function pressDodge(deadline)
		local frames = 0
		while alive do
			local _, _, btn = gameMeter()
			if btn and btn.Visible and pressBtn(btn, "MouseButton1Down") then return "handler" end
			frames = frames + 1
			if frames >= 2 or os.clock() >= deadline then
				R.Dodge:FireServer(true)
				return "remote"
			end
			RunService.Heartbeat:Wait()
		end
	end

	keep(R.DodgePrompt.OnClientEvent:Connect(function(window)
		window = tonumber(window) or 0.25
		promptT = os.clock()
		stats.prompts = stats.prompts + 1
		local n = stats.prompts
		pillDodge("Dodge: PROMPT", T.warn)
		later(math.max(window, 0.4), function() pillDodge("Dodge: standby", T.sub) end)
		if not S.autoDodge then
			dodgeInfo.Text = ("Prompt #%d (window %.2fs) | auto dodge OFF"):format(n, window)
			return
		end
		local delay = 0
		if S.dodgeMode == "Human" then
			if math.random(100) > S.dChance then
				addLog("dodge dilewati (peluang)", T.warn)
				dodgeInfo.Text = ("Prompt #%d | dilewati oleh peluang %d%%"):format(n, S.dChance)
				return
			end
			local lo, hi = math.min(S.dMin, S.dMax), math.max(S.dMin, S.dMax)
			delay = math.min(math.random(lo, hi) / 1000, window * 0.6)
		end
		token = token + 1
		local mine, t0 = token, promptT
		task.spawn(function()
			if delay > 0 then task.wait(delay) else RunService.Heartbeat:Wait() end
			if not alive or mine ~= token then return end
			local ok, how = pcall(pressDodge, t0 + window * 0.85)
			how = ok and how or "error"
			local ms = math.floor((os.clock() - t0) * 1000 + 0.5)
			addLog(("dodge via %s (window %.2fs, +%dms)"):format(how, window, ms), ok and T.good or T.bad)
			dodgeInfo.Text = ("Prompt #%d | window %.2fs | tekan di +%d ms | via %s"):format(n, window, ms, how)
		end)
	end))

	keep(R.DodgeResult.OnClientEvent:Connect(function(ok)
		local ms = math.floor((os.clock() - promptT) * 1000 + 0.5)
		if ok then
			stats.dodgeOk = stats.dodgeOk + 1
			toast(("Dodge berhasil (%d ms)"):format(ms), T.good)
		else
			stats.dodgeFail = stats.dodgeFail + 1
			toast("Dodge gagal", T.bad)
		end
		refreshStats()
		addLog(("hasil dodge: %s | %d ms setelah prompt | ping %d ms"):format(ok and "BERHASIL" or "GAGAL", ms, getPing()), ok and T.good or T.bad)
	end))
end

