local function refreshCulprit()
	local e = culprit or (lastSlap and os.clock() - lastSlap.t < 60 and lastSlap) or nil
	if not e then
		cName.Text, cInfo.Text, av.Image = "Belum ada", "Menunggu slap...", ""
	else
		local p = e.plr
		av.Image = thumb(p, 150)
		cName.Text = (p.DisplayName == p.Name) and p.Name or (p.DisplayName .. " (@" .. p.Name .. ")")
		cInfo.Text = ("%s | %s | %d dtk lalu"):format(e.move, e.src, math.floor(os.clock() - e.t))
	end
