local function gameMeter()
	local g = gameGui()
	if not g then return nil end
	local m, bar, btn = cache.meter, cache.bar, cache.btn
	if not (m and m.Parent and bar and bar.Parent) then
		m = g:FindFirstChild("meter")
		local c = m and m:FindFirstChild("color")
		bar = c and c:FindFirstChild("bar")
		cache.meter, cache.bar = m, bar
